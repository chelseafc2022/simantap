# Application Config
NODE_ENV=development
APP_PORT=4000
API_PREFIX=api/v1
CLIENT_URL=http://localhost:3000

# Database PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simantap?schema=public

# JWT Security
JWT_ACCESS_SECRET=simantap-jwt-access-secret-super-secure-key-2026-production-ready
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=simantap-jwt-refresh-secret-super-secure-key-2026-production-ready
JWT_REFRESH_EXPIRES_IN=7d

# Redis Cache & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Mailer (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MONALISA KONSEL Pemkab Konawe Selatan" <noreply@konaweselatankab.go.id>

# E-Gov & SIMPEG MySQL (READ-ONLY External Database)
EGOV_MYSQL_HOST=mysql.konaweselatankab.go.id
EGOV_MYSQL_USER=your_mysql_user
EGOV_MYSQL_PASSWORD=your_mysql_password
EGOV_MYSQL_PORT=3306
EGOV_MYSQL_LIMIT=20

# Sumber RUP Konsel Setara (READ-ONLY). Jika host/user/password/port kosong,
# backend memakai koneksi EGOV_MYSQL_* di atas.
KONSEL_SETARA_MYSQL_DATABASE=konsel_setara
KONSEL_SETARA_MYSQL_HOST=
KONSEL_SETARA_MYSQL_USER=
KONSEL_SETARA_MYSQL_PASSWORD=
KONSEL_SETARA_MYSQL_PORT=
