{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  },
  "include": [
    "backend/src/**/*",
    "backend/prisma/**/*"
  ],
  "exclude": [
    "node_modules",
    "backend/dist",
    "frontend"
  ]
}
